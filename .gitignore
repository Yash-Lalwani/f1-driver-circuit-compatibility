# Ignore CSV data files but keep folder structure
data/raw/*.csv
data/processed/*.csv
data/cache/

# Keep the .gitkeep placeholder files
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/cache/.gitkeep

# Trained model files
models/*.pkl

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Environments
.env
.venv
venv/
env/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/

